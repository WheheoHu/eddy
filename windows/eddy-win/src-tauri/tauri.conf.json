{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eddy",
  "version": "0.1.0",
  "identifier": "app.eddy.windows",
  "build": {
    "beforeDevCommand": "npm run fe:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fe:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eddy",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}

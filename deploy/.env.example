# Encrypts the FreshRSS password at rest. Generate once and keep it with your
# backups: openssl rand -base64 32
EDDY_MASTER_KEY=
# How often the server pulls FreshRSS.
EDDY_REFRESH_MINUTES=15

# --- Optional: Server-side Video-to-Book background jobs ---
# Keys stay strictly in this file on your server and are never uploaded from
# or exposed to client devices (`/v1/info` only reports `video_capable: bool`).
#
# EDDY_VIDEO_TARGET_LANGUAGE=简体中文
# EDDY_VIDEO_PIPELINE=auto
# EDDY_VIDEO_TRANSCRIPT_POLICY=prefer_any_subtitles
# EDDY_VIDEO_CHAPTER_CONCURRENCY=2
#
# EDDY_VIDEO_ASR_PROTOCOL=openai
# EDDY_VIDEO_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

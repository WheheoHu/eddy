{
  "manifest_version": 3,
  "name": "Save to Eddy",
  "description": "把正在看的页面（包括已登录才能看到的内容）交给 Eddy 稍后阅读，或者订阅它的 RSS 源。",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "保存到 Eddy",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      }
    }
  }
}

{
  "manifest_version": 3,
  "name": "Save to Eddy",
  "description": "把正在看的页面（包括已登录才能看到的内容）交给 Eddy 稍后阅读，或者订阅它的 RSS 源。",
  "version": "0.3.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "contextMenus",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://rsshub.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "保存到 Eddy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      }
    }
  }
}
